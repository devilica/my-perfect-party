{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo start --web",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
