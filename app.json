{
  "expo": {
    "name": "My Perfect Party",
    "slug": "wedding-planner-bh",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mojasavrsenaproslava",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mojasavrsenaproslava.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 11,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF8F4"
      },
      "package": "com.mojasavrsenaproslava.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withRemoveMediaReadPermissions.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      "expo-localization",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5452343649745884~9366452184",
          "iosAppId": "ca-app-pub-5452343649745884~9366452184"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-mail-composer",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save invitation images.",
          "savePhotosPermission": "Allow saving invitation images to your gallery.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C9686F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7ce9023d-6786-4cdd-8359-c02efee636f5"
      }
    },
    "owner": "devilica"
  }
}
